---
import SectionHeading from './SectionHeading.astro';
import { soundCopy } from '@config/content';
import { business } from '@config/business';

const facts = [
  { term: 'Experience', detail: business.facts.experienceLong },
  { term: 'Based in', detail: `${business.location.region} · ${business.location.cities.join(', ')}` },
  { term: 'Languages', detail: business.facts.languages.join(' & ') },
  { term: 'Travel', detail: business.location.travelNote },
];
---

<section id="sound" aria-labelledby="sound-title">
  <div class="container-site section-space">
    <SectionHeading id="sound-title" index={soundCopy.index} label={soundCopy.label} headline={soundCopy.headline} />

    <div class="mt-14 grid gap-14 lg:mt-20 lg:grid-cols-12 lg:gap-10">
      <!-- Philosophy + facts -->
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-[calc(var(--nav-height)+2.5rem)]" data-reveal>
          {
            soundCopy.intro.map((paragraph, index) => (
              <p class:list={['max-w-xl', index === 0 ? 'lede text-ink' : 'mt-5 text-stone']}>{paragraph}</p>
            ))
          }
          <dl class="mt-10 grid grid-cols-1 border-t border-line sm:grid-cols-2 lg:grid-cols-1">
            {
              facts.map(({ term, detail }) => (
                <div class="border-b border-line py-4 sm:odd:pr-6 lg:odd:pr-0">
                  <dt class="eyebrow text-stone">{term}</dt>
                  <dd class="mt-1.5 font-medium text-ink">{detail}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <!-- Pillars -->
      <ol class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:col-span-7 lg:col-start-6 lg:pl-10">
        {
          soundCopy.pillars.map((pillar, index) => (
            <li class="border-t border-ink pt-6" data-reveal style={`--reveal-delay: ${(index % 2) * 90}ms`}>
              <span class="font-display text-sm font-semibold tracking-[0.04em] text-gold-ink">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-5 text-[1.6rem] leading-tight font-semibold tracking-[-0.025em]">{pillar.title}</h3>
              <p class="mt-4 text-stone">{pillar.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <!-- Services band -->
  <div class="on-dark bg-ink text-ivory">
    <div class="container-site py-[clamp(4.5rem,9vw,7.5rem)]">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-4" data-reveal>
          <p class="eyebrow flex items-center gap-4 text-ivory/70">
            <span class="rule-gold" aria-hidden="true"></span>Events
          </p>
          <h3 class="heading-lg mt-6 text-ivory">{soundCopy.servicesHeadline}</h3>
          <p class="mt-5 max-w-sm text-ivory/70">{soundCopy.servicesIntro}</p>
        </div>

        <ul class="grid grid-cols-1 sm:grid-cols-2 sm:gap-x-10 lg:col-span-8 lg:grid-cols-3" aria-label="Event types">
          {
            business.services.map((service, index) => (
              <li class="flex items-baseline gap-4 border-b border-line-dark py-4 text-[1.05rem] font-medium">
                <span class="w-6 font-display text-xs text-gold">{String(index + 1).padStart(2, '0')}</span>
                {service}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-14 flex flex-col gap-4 border-t border-line-dark pt-8 lg:flex-row lg:items-baseline lg:gap-10" data-reveal>
        <p class="eyebrow shrink-0 text-gold">{soundCopy.genresLabel}</p>
        <ul class="flex flex-wrap gap-x-2.5 gap-y-1.5 text-ivory/75" aria-label="Music genres">
          {
            business.genres.map((genre) => (
              <li class="after:ml-2.5 after:text-ivory/30 after:content-['/'] last:after:content-none">{genre}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
