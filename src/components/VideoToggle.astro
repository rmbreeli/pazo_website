---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';

/**
 * Round play/pause button for muted background videos (hero + gallery tiles).
 * Starts hidden so it never shows without JavaScript; each video's script
 * reveals it and keeps aria-pressed / aria-label in sync. The icon follows
 * aria-pressed automatically.
 */
type Props = HTMLAttributes<'button'>;

const { class: className, ...attrs } = Astro.props;
---

<button
  type="button"
  class:list={[
    'inline-flex h-11 w-11 items-center justify-center rounded-full border border-ivory/40 text-ivory transition-colors hover:bg-ivory hover:text-ink',
    className,
  ]}
  aria-pressed="false"
  hidden
  {...attrs}
>
  <Icon name="play" size={16} class="hidden [[aria-pressed=false]_&]:block" />
  <Icon name="pause" size={16} class="hidden [[aria-pressed=true]_&]:block" />
</button>
