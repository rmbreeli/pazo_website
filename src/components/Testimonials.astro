---
import ReviewItem from './ReviewItem.astro';
import { attributionFor, testimonials, visibleSupportingReviews } from '@config/testimonials';
import { reviewsCopy } from '@config/content';

const featured = testimonials.find((t) => t.featured) ?? testimonials[0];
const supporting = testimonials.filter((t) => t !== featured);
const visible = supporting.slice(0, visibleSupportingReviews);
const more = supporting.slice(visibleSupportingReviews);
const featuredAttribution = featured && attributionFor(featured);
---

<div class="grid gap-14 lg:grid-cols-12 lg:gap-10">
  {
    featured && (
      <figure class="lg:col-span-7" data-reveal>
        <p class="eyebrow text-stone">{reviewsCopy.reviewsLabel}</p>
        <span class="mt-8 block font-display text-[5.5rem] leading-[0.6] text-gold" aria-hidden="true">
          &ldquo;
        </span>
        <blockquote class="mt-2">
          <p class="font-display text-[clamp(1.7rem,3.3vw,2.85rem)] leading-[1.14] font-medium tracking-[-0.025em] text-ink">
            {featured.quote}
          </p>
        </blockquote>
        <figcaption class="mt-8 flex items-center gap-4">
          <span class="rule-gold" aria-hidden="true" />
          <span>
            <span class="block font-semibold text-ink">{featured.name}</span>
            {featuredAttribution && <span class="block text-sm text-stone">{featuredAttribution}</span>}
          </span>
        </figcaption>
      </figure>
    )
  }

  <div class="lg:col-span-5 lg:col-start-8 lg:pt-14">
    <ul class="border-t border-line">
      {
        visible.map((t, index) => (
          <li class="border-b border-line py-7" data-reveal style={`--reveal-delay: ${index * 80}ms`}>
            <ReviewItem testimonial={t} />
          </li>
        ))
      }
    </ul>

    {
      more.length > 0 && (
        <details class="group border-b border-line">
          <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between py-4 text-sm font-bold tracking-[0.08em] uppercase [&::-webkit-details-marker]:hidden">
            More reviews ({more.length})
            <span class="text-xl leading-none transition-transform group-open:rotate-45" aria-hidden="true">
              +
            </span>
          </summary>
          <ul>
            {more.map((t) => (
              <li class="border-t border-line py-7">
                <ReviewItem testimonial={t} />
              </li>
            ))}
          </ul>
        </details>
      )
    }
  </div>
</div>
