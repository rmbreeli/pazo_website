---
/**
 * Inline SVG icons. Decorative by default (aria-hidden); pass `label`
 * when an icon is the only content of a control.
 */
interface Props {
  name:
    | 'arrow-right'
    | 'arrow-down'
    | 'arrow-up-right'
    | 'instagram'
    | 'soundcloud'
    | 'youtube'
    | 'mail'
    | 'phone'
    | 'play'
    | 'pause'
    | 'close'
    | 'check';
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 18, label, class: className } = Astro.props;

const paths: Record<Props['name'], string> = {
  'arrow-right': '<path d="M4 12h15m-6-6 6 6-6 6" />',
  'arrow-down': '<path d="M12 4v15m-6-6 6 6 6-6" />',
  'arrow-up-right': '<path d="M7 17 17 7M8 7h9v9" />',
  instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />',
  soundcloud:
    '<path d="M3 16v-3M6 17v-6M9 17V9M12 17V7.5c3.6-.6 6.4 1.6 6.9 4.6A2.9 2.9 0 0 1 18.5 17H12" />',
  youtube:
    '<rect x="2.5" y="5.5" width="19" height="13" rx="3.5" /><path d="m10.5 9.5 4 2.5-4 2.5z" fill="currentColor" />',
  mail: '<rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="m3.5 6 8.5 7 8.5-7" />',
  phone:
    '<path d="M5 4h3.5l1.5 4.5-2 1.5a11 11 0 0 0 6 6l1.5-2L20 15.5V19a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z" />',
  play: '<path d="M8 5.5v13l10.5-6.5z" fill="currentColor" stroke="none" />',
  pause:
    '<rect x="6.5" y="5" width="3.5" height="14" fill="currentColor" stroke="none" /><rect x="14" y="5" width="3.5" height="14" fill="currentColor" stroke="none" />',
  close: '<path d="M6 6l12 12M18 6 6 18" />',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5" />',
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['shrink-0', className]}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={paths[name]}
/>
