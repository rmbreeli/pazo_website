---
import Button from './Button.astro';
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import { heroCopy } from '@config/content';
import { business } from '@config/business';
import { hero } from '@config/media';
import { firstExistingAsset, publicAssetExists } from '@lib/assets';
import { firstFrame } from '@lib/autoplay-video';

const videoSrc = firstExistingAsset(hero.videoCandidates);
const webmSrc = publicAssetExists(hero.videoWebm) ? hero.videoWebm : undefined;
// A video always wins: the poster image is only shown when there is no hero video at all.
const showPoster = !videoSrc && publicAssetExists(hero.poster);
---

<section id="home" aria-labelledby="hero-title" class="relative pt-[calc(var(--nav-height)+clamp(2rem,6vw,4.5rem))]">
  <div class="container-site">
    <div class="grid gap-x-10 gap-y-8 lg:grid-cols-12 lg:items-end">
      <h1 id="hero-title" class="lg:col-span-8">
        <span class="eyebrow flex flex-wrap items-center gap-x-4 gap-y-1 text-stone" data-reveal>
          <span class="whitespace-nowrap text-ink">{business.brand}</span>
          <span class="rule-gold hidden sm:block" aria-hidden="true"></span>
          <span class="whitespace-nowrap">{heroCopy.eyebrow}</span>
        </span>
        <span
          class="display mt-6 block text-[clamp(2.35rem,12.4vw,6rem)] uppercase lg:mt-8 lg:text-[clamp(5rem,7.9vw,7.75rem)]"
          data-reveal
          style="--reveal-delay: 80ms"
        >
          {heroCopy.headline.map((line) => <span class="block">{line}</span>)}
        </span>
      </h1>

      <div class="lg:col-span-4 lg:pb-2" data-reveal style="--reveal-delay: 160ms">
        <p class="lede max-w-md text-stone">{heroCopy.supporting}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
          <Button href="#packages" variant="primary">{heroCopy.primaryCta}</Button>
          <Button href="#contact" variant="secondary" arrow={false}>{heroCopy.secondaryCta}</Button>
        </div>
      </div>
    </div>

    <!-- Cinematic media frame. Deliberately NOT animated: it holds the first thing visitors see. -->
    <div class="relative mt-12 aspect-[4/5] overflow-hidden bg-ink sm:aspect-[16/10] lg:mt-16 lg:aspect-[21/9]">
      {
        showPoster && (
          <img
            src={hero.poster}
            alt={hero.posterAlt}
            class="absolute inset-0 h-full w-full object-cover"
            style={`object-position: ${hero.focus}`}
            width="2000"
            height="1333"
            fetchpriority="high"
            decoding="async"
          />
        )
      }
      {
        videoSrc && (
          <video
            class="absolute inset-0 h-full w-full object-cover"
            style={`object-position: ${hero.focus}`}
            muted
            loop
            playsinline
            preload="metadata"
            disablepictureinpicture
            aria-hidden="true"
            data-hero-video
          >
            {webmSrc && <source src={firstFrame(webmSrc)} type="video/webm" />}
            <source src={firstFrame(videoSrc)} type="video/mp4" />
          </video>
        )
      }

      <!-- Legibility scrim + signature wordmark -->
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/10 to-ink/20" aria-hidden="true"></div>
      <Wordmark
        tone="light"
        aria-hidden="true"
        class="pointer-events-none absolute bottom-0 left-[var(--gutter)] translate-y-[14%] text-[clamp(5.5rem,23vw,20rem)] lg:left-10"
      />

      <ul class="absolute top-5 left-5 flex flex-wrap gap-x-5 gap-y-1 sm:top-7 sm:left-7" aria-label="Event specialties">
        {heroCopy.highlights.map((item) => <li class="eyebrow text-ivory/90">{item}</li>)}
      </ul>

      {
        videoSrc && (
          <button
            type="button"
            class="absolute right-4 bottom-4 inline-flex h-11 w-11 items-center justify-center rounded-full border border-ivory/40 text-ivory transition-colors hover:bg-ivory hover:text-ink sm:right-7 sm:bottom-7"
            aria-label="Play background video"
            aria-pressed="false"
            data-hero-toggle
            hidden
          >
            <Icon name="play" size={16} class="hidden [[aria-pressed=false]_&]:block" />
            <Icon name="pause" size={16} class="hidden [[aria-pressed=true]_&]:block" />
          </button>
        )
      }
    </div>

    <div class="flex flex-col gap-3 border-b border-line py-6 text-sm text-stone sm:flex-row sm:items-center sm:justify-between">
      <p>
        Based in <strong class="font-semibold text-ink">{business.location.region}</strong>
        <span class="mx-2 text-gold" aria-hidden="true">/</span>
        Available throughout Arkansas &amp; Beyond
      </p>
      <a href="#sound" class="link-line inline-flex items-center gap-2 self-start font-semibold text-ink sm:self-auto">
        Discover the sound <Icon name="arrow-down" size={15} />
      </a>
    </div>
  </div>
</section>

<script>
  import { canAutoplay } from '@lib/autoplay-video';

  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');

  if (video && toggle) {
    // Reduce Motion / Data Saver: the video rests on its first frame until the visitor presses play.
    let userPaused = !canAutoplay();

    const sync = (playing: boolean) => {
      toggle.setAttribute('aria-pressed', String(playing));
      toggle.setAttribute('aria-label', playing ? 'Pause background video' : 'Play background video');
    };

    const play = () => video.play().then(() => sync(true)).catch(() => sync(false));

    video.querySelector('source:last-of-type')?.addEventListener('error', () => {
      toggle.hidden = true;
      video.remove();
    });

    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      userPaused = !video.paused;
      if (video.paused) play();
      else {
        video.pause();
        sync(false);
      }
    });

    // Plays the moment it is on screen (straight away on page load); pauses off screen to save battery.
    new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) video.pause();
      else if (!userPaused) play();
    }).observe(video);
  }
</script>
