# Copy to `.env` for local overrides. Never commit `.env`.
#
# Web3Forms access key used by the contact form.
# Web3Forms access keys are PUBLIC by design (they only allow sending a
# submission to the inbox the key was registered with), so the existing key
# is kept as a default in src/config/business.ts. Set this variable (locally
# or in Netlify > Site configuration > Environment variables) to override it,
# e.g. after generating a new key at https://web3forms.com/.
PUBLIC_WEB3FORMS_ACCESS_KEY=
